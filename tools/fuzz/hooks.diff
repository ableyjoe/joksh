 /* tty I/O */
 
+#ifdef KSH_FUZZ
+void		(*x_fuzz_cb)(void);
+static long	x_fuzz_nread;
+static int	x_fuzz_on = -1;
+
+static void
+x_fuzz_osc(const char *s, size_t n)
+{
+	size_t	off = 0;
+	ssize_t	r;
+
+	while (off < n && (r = write(1, s + off, n - off)) > 0)
+		off += r;
+}
+
+static int
+x_fuzz_enabled(void)
+{
+	if (x_fuzz_on < 0)
+		x_fuzz_on = getenv("KSH_FUZZ") != NULL;
+	return x_fuzz_on;
+}
+
+static void
+x_fuzz_hex(char *o, const char *buf, int len)
+{
+	static const char	hex[] = "0123456789abcdef";
+	int			i;
+
+	for (i = 0; i < len; i++) {
+		*o++ = hex[(unsigned char)buf[i] >> 4];
+		*o++ = hex[(unsigned char)buf[i] & 15];
+	}
+	*o = '\0';
+}
+
+/* Report the editor's state, once its output is all written. */
+void
+x_fuzz_dump(int tag, int extra, const char *buf, int len, int cursor)
+{
+	static char	out[64 + 2 * LINE + 64];
+	int		n;
+
+	if (!x_fuzz_enabled())
+		return;
+	x_flush();
+	if (len < 0 || len > LINE)
+		len = 0;
+	n = snprintf(out, 64, "\033]777;D %c %d %d %d %d %d %ld %d %d ",
+	    tag, extra,
+#ifndef SMALL
+	    x_ml_on, x_ml_held,
+#else
+	    0, 0,
+#endif
+	    x_cols, x_lins, x_fuzz_nread, cursor, len);
+	x_fuzz_hex(out + n, buf, len);
+	n += 2 * len;
+	out[n++] = '\007';
+	x_fuzz_osc(out, n);
+}
+#endif
